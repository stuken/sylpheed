# Game data, build output and captures stay local.
/assets/
/out/
/dist/
*.rdc
*.log

# Build artifacts regenerated by CMakeLists.txt.
/src/*.generated.*

# Python caches.
__pycache__/
*.pyc

# Editors.
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
